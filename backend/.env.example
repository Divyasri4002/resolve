# --- Database ---
DATABASE_URL=postgresql+asyncpg://resolve:resolve@localhost:5432/resolve

# --- Razorpay (TEST MODE keys only — never put live keys in this repo) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# --- Reasoning provider (LLM used ONLY for proposing plans, never for approving them) ---
# Options:
#   "mock"   → deterministic stand-in, no key needed, good for testing Authority Engine
#   "groq"   → fast inference API, get key at https://console.groq.com/keys
#              Models: openai/gpt-oss-120b (default; native tool calling), openai/gpt-oss-20b.
#              Check GET https://api.groq.com/openai/v1/models for what the account currently serves.
#   "gemini" → Google Gemini API, get key at https://makersuite.google.com/app/apikey
REASONING_PROVIDER=gemini
REASONING_API_KEY=
# Groq-specific credential and model — preferred over REASONING_API_KEY when REASONING_PROVIDER=groq,
# so a Gemini key and a Groq key can coexist in this file without switching meaning.
REASONING_GROQ_API_KEY=
REASONING_GROQ_MODEL=openai/gpt-oss-120b

# --- Product Search Provider (Real product discovery) ---
PRODUCT_SEARCH_PROVIDER=serpapi
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search

# --- Shopify READ-ONLY connectivity (Task 14B.3) ---
# Empty placeholders ONLY. Never put real credentials in this file. Populate them in backend/.env.
# This integration is read-only (read_products, read_orders, read_returns). No write scopes.
SHOPIFY_STORE_DOMAIN=resolve-commerce-lab.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07
# Retention (days) for Shopify-DERIVED protected data only — never core mission/payment/audit
# records. Default is 30; the current policy is reporting/dry-run only (see docs).
SHOPIFY_RETENTION_DAYS=30

# --- App ---
ENV=development
LOG_LEVEL=INFO

# --- Auth & CORS ---
AUTH_SECRET=your_auth_secret_signing_key_here
FRONTEND_ORIGIN=http://localhost:3000

# --- Machine-to-machine service reads (scratch purchase runner preflight) ---
# Shared secret RESOLVE requires in the X-Resolve-Service-Token header before serving the
# runner's two READ-ONLY preflight reads (a store-associated mission's canonical order and
# checkout selection). Empty = the service read path is disabled entirely. The merchant
# channel must hold the SAME value as MERCHANT_RESOLVE_SERVICE_TOKEN, in the channel's OWN
# environment — never in this file, and never in both roles. The value is never committed,
# printed, logged, or returned in a response.
SERVICE_RUNNER_TOKEN=

# NOTE: This template holds placeholders only. Real credentials belong in backend/.env (never committed). Groq keys are configured in REASONING_API_KEY / REASONING_GROQ_API_KEY above.
