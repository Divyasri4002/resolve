            assert retried.status_code == 200
            assert mock_razorpay["n"] == 2
            razorpay_order_id = retried.json()["payment"]["razorpay_order_id"]
            verified = await client.post(
                f"/missions/{mission_id}/shopping/payment/verify",
                json={
