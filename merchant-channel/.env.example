# The merchant-side purchase channel's own configuration.
#
# This file documents the MERCHANT_* environment values the channel reads
# (merchant_channel/config.py). It is NOT RESOLVE's configuration: the channel never reads
# RESOLVE's environment names, and RESOLVE-owned values (SHOPIFY_*, LINKAGE_INTEGRATION_SECRET,
# RAZORPAY_*) set in this process are a configuration ERROR, not a convenience.
#
# Where the channel's SQLite outbox lives is not a credential question — it is passed to
# Outbox(...) by the runner, not read from the environment.

# --- The merchant store ---------------------------------------------------------------
MERCHANT_SHOPIFY_STORE_DOMAIN=
MERCHANT_SHOPIFY_API_VERSION=2026-07

# --- Shopify credential (exactly one of the two paths) --------------------------------
#
# Static path (optional legacy/controlled deployments): a pre-provisioned Admin API access
# token, used exactly as supplied. When this is set it WINS and the channel performs ZERO
# token-grant requests.
MERCHANT_SHOPIFY_ACCESS_TOKEN=

# Preferred current Shopify Dev Dashboard path: client credentials exchanged for a temporary
# access token (grant_type=client_credentials). The token is cached in memory and refreshed
# automatically before it expires — access tokens from this grant are temporary (about 24
# hours) and must never be pasted by hand per day. MERCHANT_SHOPIFY_CLIENT_SECRET is
# sensitive: it is wrapped in the package's Secret abstraction and never rendered, logged, or
# written to the outbox.
#
# Precedence: MERCHANT_SHOPIFY_ACCESS_TOKEN wins when supplied; otherwise both of the two
# values below are required; with neither, the channel refuses to act.
MERCHANT_SHOPIFY_CLIENT_ID=
MERCHANT_SHOPIFY_CLIENT_SECRET=

# --- Linkage delivery -----------------------------------------------------------------
# HMAC secret shared with RESOLVE. RESOLVE must be configured with the same value as its
# LINKAGE_INTEGRATION_SECRET, in RESOLVE's own environment, never in this one.
MERCHANT_LINKAGE_SECRET=
MERCHANT_RESOLVE_BASE_URL=

# --- Machine credential for RESOLVE's read-only preflight reads -------------------------
# The same value RESOLVE holds as SERVICE_RUNNER_TOKEN, in RESOLVE's own environment — never
# in this one. The scratch runner presents it in the X-Resolve-Service-Token header when it
# reads a mission's canonical order and checkout selection; without it those reads fail
# closed before any request. Never committed, printed, or logged.
MERCHANT_RESOLVE_SERVICE_TOKEN=

# --- Expectations the channel verifies before it will pair anything -------------------
# The currency RESOLVE actually charges in. The channel refuses a handoff priced in any other
# currency: nothing converts, and nothing may invent a rate.
MERCHANT_EXPECTED_CURRENCY=INR
# Optional pin: the shop name the read-back must come from.
MERCHANT_EXPECTED_SHOP_NAME=
MERCHANT_CHANNEL_SOURCE=merchant-purchase-channel
